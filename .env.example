# Server
SERVER_ADDR=127.0.0.1:8080           # Bind to localhost only — reverse proxy required
HOST_PORT=127.0.0.1:8080             # Docker host:port mapping (default: 127.0.0.1:8080)
SERVER_ENV=production                # production, development
APP_BASE_URL=https://app.example.com # Frontend URL (for emails, redirects)
API_BASE_URL=https://api.example.com # Public API URL (behind reverse proxy)

# Positive HTTP timeouts; read-header <= read <= request <= write
SERVER_READ_HEADER_TIMEOUT=2s
SERVER_READ_TIMEOUT=120s
SERVER_REQUEST_TIMEOUT=180s
SERVER_WRITE_TIMEOUT=180s
SERVER_IDLE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=30s           # One budget for HTTP, workers, mail/audit and pool

# Trusted Proxies (CIDR notation, comma-separated)
# Only connections from these IPs may set X-Forwarded-For.
# Caddy/Nginx on same host: 127.0.0.1/8,::1/128
# Traefik in Docker network: 172.16.0.0/12
TRUSTED_PROXIES=127.0.0.1/8,::1/128

# Database
DATABASE_URL=postgres://sshvault:CHANGE_ME@localhost:5432/sshvault?sslmode=disable # Native server/CLI
POSTGRES_PASSWORD=CHANGE_ME          # Docker Compose injects this safely for postgres, server, and backup

# JWT
JWT_PRIVATE_KEY_PATH=./keys/ed25519.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Mail (leave empty to use noop mailer — logs complete emails, including one-time links, to stdout)
SMTP_HOST=
SMTP_PORT=587                       # STARTTLS required; 465 uses implicit TLS
SMTP_CONNECT_TIMEOUT=10s
SMTP_COMMAND_TIMEOUT=10s
SMTP_DELIVERY_TIMEOUT=30s            # Includes connection; must cover connect/command
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Vault (hard ceiling 15 MiB decoded; proxy wire limit 21037056 bytes)
VAULT_MAX_SIZE_MB=15
VAULT_HISTORY_LIMIT=10

# Rate Limiting
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# Backup (for CLI auto-backup)
BACKUP_DIR=./backups
BACKUP_INTERVAL=24h
BACKUP_RETENTION=7

# CORS (comma-separated origins; empty uses built-in SSHVault web origins)
CORS_ORIGINS=

# Server Identity
SERVER_ID=sshvault-primary

# Logging (leave LOG_FILE_PATH empty to log to stdout only)
LOG_FILE_PATH=
LOG_MAX_SIZE_MB=100
LOG_MAX_AGE_DAYS=90
LOG_MAX_BACKUPS=10
LOG_COMPRESS=true

# Audit
AUDIT_RETENTION_DAYS=365
AUDIT_BUFFER_SIZE=4096
